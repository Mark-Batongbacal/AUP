# ==============================================================================
# TUKI BACKEND HTTP SCRATCHPAD
# Branch contract: dev
# ==============================================================================
#
# Recommended passenger flow:
#   1) Login
#   2) Search destination (optional)
#   3) POST /api/journeys/plan
#   4) POST /api/navigation/start
#   5) POST /api/navigation/{sessionId}/location repeatedly
#   6) Confirm boarding/alighting only when requested by the snapshot
#
# Legacy Trips / TripSessions endpoints are kept near the bottom for diagnostics.
#
# IMPORTANT:
# - Copy apiKey from login/register into @apiKey.
# - Copy recommendationId from /api/journeys/plan into @recommendationId.
# - Copy sessionId from /api/navigation/start into @sessionId.
# ==============================================================================


# ==============================================================================
# 00 — ENVIRONMENT / VARIABLES
# ==============================================================================

# @host = http://localhost:5129
@host = http://tuki-api.japaneast.cloudapp.azure.com:5129

@apiKey = apikey

# Common Porac -> Angeles sample 15.136824336548178, 120.58674703311
@originLat = 15.12254950605129
@originLon = 120.5997480979361
# @originLat = 15.109698583445889
# @originLon = 120.58240903543013


@destinationLat = 15.139582098206548
@destinationLon = 120.60108373338038
@destinationName = Diegs

# Replace from API responses
@recommendationId = 7211433e-f36b-1410-8642-00e4c9b18fbc
@sessionId = 6d13433e-f36b-1410-8642-00e4c9b18fbc
@tripId = 3a12433e-f36b-1410-8642-00e4c9b18fbc
@driverId = 00000000-0000-0000-0000-000000000000
@vehicleId = 00000000-0000-0000-0000-000000000000
@rideRequestId = 00000000-0000-0000-0000-000000000000
@rideMatchId = 00000000-0000-0000-0000-000000000000

@routeId = 1
@tricyclePointId = 1


# ==============================================================================
# 01 — HEALTH
# ==============================================================================

### Health — anonymous
GET {{host}}/health
Accept: application/json


# ==============================================================================
# 02 — AUTHENTICATION
# ==============================================================================

### Login
# Copy response.apiKey into @apiKey above.
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "userName": "{{$dotenv Login__Users__0__UserName}}",
  "password": "{{$dotenv Login__Users__0__Password}}"
}


### Register configured local account
POST {{host}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "userName": "{{$dotenv Login__Users__0__UserName}}",
  "password": "{{$dotenv Login__Users__0__Password}}",
  "firstName": "Mark",
  "lastName": "Batongbacal",
  "phoneNumber": null
}


### Auth identity
GET {{host}}/api/auth/me
Accept: application/json
X-Api-Key: {{apiKey}}


### Google login — replace with a real ID token
POST {{host}}/api/auth/google
Content-Type: application/json
Accept: application/json

{
  "idToken": "REPLACE_WITH_GOOGLE_ID_TOKEN"
}


### Facebook login — Android / access token
POST {{host}}/api/auth/facebook
Content-Type: application/json
Accept: application/json

{
  "accessToken": "REPLACE_WITH_FACEBOOK_ACCESS_TOKEN"
}


### Facebook OIDC login
POST {{host}}/api/auth/facebook/oidc
Content-Type: application/json
Accept: application/json

{
  "idToken": "REPLACE_WITH_FACEBOOK_OIDC_ID_TOKEN",
  "nonce": "REPLACE_WITH_NONCE"
}


# ==============================================================================
# 03 — CURRENT USER
# ==============================================================================

### Get current profile
GET {{host}}/api/users/me
Accept: application/json
X-Api-Key: {{apiKey}}


### Update current profile
PUT {{host}}/api/users/me
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "firstName": "Mark",
  "lastName": "Batongbacal",
  "phoneNumber": null,
  "profileImageUrl": null
}


# ==============================================================================
# 04 — DESTINATION / PLACE SEARCH
# ==============================================================================

### Search destination near current origin
GET {{host}}/api/places/search?q=jollibee&focusLat={{destinationLat}}&focusLon={{destinationLon}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Search without focus coordinates
GET {{host}}/api/places/search?q=jollibee
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 05 — JOURNEY PLANNING — RECOMMENDED MOBILE FLOW
# ==============================================================================
#
# This endpoint BOTH:
# - calculates plans
# - persists startable recommendations
#
# Copy one response[].recommendationId into @recommendationId.
# ==============================================================================

### Plan + persist journey recommendations
POST {{host}}/api/journeys/plan
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "originLatitude": {{originLat}},
  "originLongitude": {{originLon}},
  "destinationName": "{{destinationName}}",
  "destinationLatitude": {{destinationLat}},
  "destinationLongitude": {{destinationLon}},
  "budget": 100,
  "preference": "efficient"
}


### Plan + persist — no budget/preference
POST {{host}}/api/journeys/plan
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "originLatitude": {{originLat}},
  "originLongitude": {{originLon}},
  "destinationName": "{{destinationName}}",
  "destinationLatitude": {{destinationLat}},
  "destinationLongitude": {{destinationLon}}
}


# ==============================================================================
# 06 — LIVE NAVIGATION — RECOMMENDED MOBILE FLOW
# ==============================================================================
#
# /start creates + starts the TripSession internally.
# It should also generate deterministic instructions, prefetch landmarks,
# and return one complete NavigationSnapshot.
#
# Copy response.sessionId into @sessionId.
# ==============================================================================

### Start selected recommendation
POST {{host}}/api/navigation/start
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "recommendationId": "{{recommendationId}}"
}


### Resume / get active navigation
GET {{host}}/api/navigation/active
Accept: application/json
X-Api-Key: {{apiKey}}


### GPS update
# A single call should return the updated NavigationSnapshot.
POST {{host}}/api/navigation/{{sessionId}}/location
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "latitude": {{originLat}},
  "longitude": {{originLon}},
  "accuracyMeters": 8,
  "timestamp": "{{$datetime iso8601}}",
  "speedMetersPerSecond": 1.2,
  "bearingDegrees": 45
}


### GPS update — intentionally poor accuracy
# Useful for validating UNCERTAIN_GPS / rejection behavior.
POST {{host}}/api/navigation/{{sessionId}}/location
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "latitude": {{originLat}},
  "longitude": {{originLon}},
  "accuracyMeters": 250,
  "timestamp": "{{$datetime iso8601}}"
}


### Confirm boarding
# Call only when snapshot.requiresBoardingConfirmation is true.
POST {{host}}/api/navigation/{{sessionId}}/boarding
Accept: application/json
X-Api-Key: {{apiKey}}


### Confirm alighting
# Call only when snapshot.requiresAlightingConfirmation is true.
POST {{host}}/api/navigation/{{sessionId}}/alighting
Accept: application/json
X-Api-Key: {{apiKey}}

### Explicit reroute
# Normally the facade attempts rerouting automatically after deterministic
# OFF_ROUTE / MISSED_ALIGHT detection.
POST {{host}}/api/navigation/{{sessionId}}/reroute
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "reason": "OFF_ROUTE"
}


### Cancel navigation
POST {{host}}/api/navigation/{{sessionId}}/cancel
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 07 — TUKI AI
# ==============================================================================
#
# AI is the friendly toucan voice / intent interface.
# Deterministic routing + navigation remain authoritative.
# ==============================================================================

### Tuki — plan by natural language
POST {{host}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "message": "Tuki, paano ako makakapunta sa SM City Clark? Budget ko 100 pesos.",
  "originLatitude": {{originLat}},
  "originLongitude": {{originLon}}
}


### Tuki — navigation/status question using active trip
POST {{host}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "message": "Tuki, tama pa ba yung daan natin?"
}


### Tuki — navigation/status question with explicit session
POST {{host}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "message": "Nalampasan ko ba yung babaan?",
  "tripSessionId": "{{sessionId}}"
}


### Tuki — explicit destination selection after ambiguity
# Replace destinationId with one returned by AssistantResponse.destinations[].
POST {{host}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "message": "Plan a route to SM City Clark with a budget of 100 pesos",
  "originLatitude": {{originLat}},
  "originLongitude": {{originLon}},
  "destinationId": "REPLACE_WITH_DESTINATION_ID"
}


# ==============================================================================
# 08 — ROUTING DIAGNOSTICS / LOW-LEVEL
# ==============================================================================
#
# Good for algorithm testing.
# New mobile code should use POST /api/journeys/plan instead of /plan below.
# ==============================================================================

### Nearby jeepney routes — Porac sample
GET {{host}}/api/test/jeepney/nearby?lat={{originLat}}&lon={{originLon}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Deterministic trip plan — NOT persisted
GET {{host}}/api/test/jeepney/plan?originLat={{originLat}}&originLon={{originLon}}&destinationLat={{destinationLat}}&destinationLon={{destinationLon}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Very short trip — useful for walk/direct-option behavior
GET {{host}}/api/test/jeepney/plan?originLat=15.109698583445889&originLon=120.58240903543013&destinationLat=15.110100&destinationLon=120.582900
Accept: application/json
X-Api-Key: {{apiKey}}


### Valhalla pedestrian diagnostic
GET {{host}}/api/test/valhalla/route?startLat={{originLat}}&startLon={{originLon}}&endLat={{destinationLat}}&endLon={{destinationLon}}
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 09 — TRANSPORT ROUTES — DATA / ADMIN
# ==============================================================================

### List active routes
GET {{host}}/api/transport-routes
Accept: application/json
X-Api-Key: {{apiKey}}


### Latest encoded route polyline
GET {{host}}/api/transport-routes/latest/polyline
Accept: application/json
X-Api-Key: {{apiKey}}


### Get ordered points for one route
GET {{host}}/api/transport-routes/{{routeId}}/points
Accept: application/json
X-Api-Key: {{apiKey}}


### Create jeepney route from ordered waypoints
# `points` are [latitude, longitude].
# Backend asks Valhalla to generate geometry through the supplied waypoints.
POST {{host}}/api/transport-routes
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "routeCode": "JEEP-SAMPLE-01",
  "routeName": "Sample Jeepney Route",
  "originName": "Sample Origin",
  "destinationName": "Sample Destination",
  "description": "Generated through Valhalla from ordered waypoints",
  "baseFare": 13,
  "points": [
    [15.169377198609359, 120.58742919718586],
    [15.153593638458716, 120.59199321409343],
    [15.137020841985489, 120.58648839309423],
    [15.133522816468420, 120.59193626047843]
  ]
}


### Replace route points directly
# Body is List<List<double>> in [latitude, longitude] order.
PUT {{host}}/api/transport-routes/{{routeId}}/points
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

[
  [15.109698583445889, 120.58240903543013],
  [15.115000000000000, 120.58500000000000],
  [15.120000000000000, 120.59000000000000]
]


