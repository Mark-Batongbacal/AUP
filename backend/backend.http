###

POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  // Change the number in the index to select a different user from the .env file
  "userName": "{{$dotenv Login__Users__0__UserName}}",
  "password": "{{$dotenv Login__Users__0__Password}}"
}

###

### Generate each consecutive waypoint segment through Valhalla, then create
### the jeepney route and its ordered geometry in one database write
POST {{backend_HostAddress}}/api/transport-routes
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "routeCode": "JEEP-SAMPLE-01",
  "routeName": "Sample Jeepney Route",
  "originName": "Sample Origin",
  "destinationName": "Sample Destination",
  "description": "Generated through Valhalla from ordered waypoints",
  "baseFare": 13,
  "points": [
  [15.169377198609359, 120.58742919718586],
  [15.153593638458716, 120.59199321409343],
  [15.137020841985489, 120.58648839309423],
  [15.13352281646842, 120.59193626047843],
  [15.135054463843517, 120.59296855755103],
  [15.135977137640078, 120.59153481161687],
  [15.145740649615238, 120.5951524696042],
  [15.168376954929752, 120.58433902456976],
  [15.166732688251642, 120.57944465448676],
  [15.166258325465854, 120.57740906289526]
]
}

###

### Add a validated tricycle pickup/service point
POST {{backend_HostAddress}}/api/tricycle-points
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "pointCode": "TRIKE-SAMPLE-04",
  "pointName": "Sample TODA Terminal",
  "description": "Main tricycle pickup point",
  "address": "Angeles, Pampanga",
  "operatorName": "Sample TODA",
  "coordinates": [15.143206444551234, 120.59700895122185],
  "radiusMeters": 500,
  "baseFare": 35,
  "farePerKilometer": 15,
  "averageWaitingTimeSeconds": 300,
  "serviceStartTime": "05:00:00",
  "serviceEndTime": "23:00:00",
  "isActive": true
}

### Register the configured .env account in UserProfiles
# Run this once before login/protected requests when the profile does not exist.
POST {{backend_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "userName": "{{$dotenv Login__Users__0__UserName}}",
  "password": "{{$dotenv Login__Users__0__Password}}",
  "firstName": "Mark",
  "lastName": "Batongbacal",
  "phoneNumber": null
}

###############################################################################
# Tuki phases 2-8 test endpoints
# These requests reuse your existing backend_HostAddress and apiKey variables.
# Run place search or AI planning first. If AI returns JOURNEYS_AVAILABLE, copy a
# journeyId below before testing the TripSession lifecycle.
###############################################################################

@tukiOriginLat = 15.109698583445889
@tukiOriginLon = 120.58240903543013
@tukiDestinationLat = 15.139582098206548
@tukiDestinationLon = 120.60108373338038
# Replace after AI returns JOURNEYS_AVAILABLE: journeys[0].journeyId
@tukiRecommendationId = 140e433e-f36b-1410-8642-00e4c9b18fbc
# Replace after Create TripSession returns HTTP 201: tripSessionId
@tukiTripSessionId = 6b0e433e-f36b-1410-8642-00e4c9b18fbc
# For simulated alighting, copy the latitude/longitude from the generated
# PrepareToAlight instruction. Do not leave these at zero when sending updates.
@tukiTestAlightLat = 15.136742
@tukiTestAlightLon = 120.58635

### Pelias destination autocomplete through Tuki
GET {{backend_HostAddress}}/api/places/search?q=SM%20City%20Clark&focusLat={{tukiOriginLat}}&focusLon={{tukiOriginLon}}
Accept: application/json
X-API-Key: {{apiKey}}

### Deterministic route planning, including graph-based transfers
GET {{backend_HostAddress}}/api/test/jeepney/plan?originLat={{tukiOriginLat}}&originLon={{tukiOriginLon}}&destinationLat={{tukiDestinationLat}}&destinationLon={{tukiDestinationLon}}
Accept: application/json
X-API-Key: {{apiKey}}

### Grounded AI route planning
# A successful response stores each option and returns its recommendation ID as
# journeys[n].journeyId. Copy one into tukiRecommendationId above.
POST {{backend_HostAddress}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "message": "Plan a route to SM City Clark with a budget of 100 pesos",
  "originLatitude": {{tukiOriginLat}},
  "originLongitude": {{tukiOriginLon}}
}

### Grounded AI route planning with an explicit Pelias selection
# Use this when AI planning returns DESTINATION_AMBIGUOUS. Copy one destination
# id from that response into destinationId.
POST {{backend_HostAddress}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "message": "Plan a route to SM City Clark with a budget of 100 pesos",
  "originLatitude": {{tukiOriginLat}},
  "originLongitude": {{tukiOriginLon}},
  "destinationId": "openstreetmap:venue:relation/15655696"
}

### Grounded AI lost/status question
# Uses the authenticated user's active trip when tripSessionId is omitted.
POST {{backend_HostAddress}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "message": "Am I still going the right way?"
}

### Create TripSession from an owned stored recommendation
# Replace tukiRecommendationId with a journeyId returned by AI planning.
POST {{backend_HostAddress}}/api/tripsessions
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "recommendationId": "{{tukiRecommendationId}}"
}

### Get the authenticated user's active TripSession
GET {{backend_HostAddress}}/api/tripsessions/active
Accept: application/json
X-API-Key: {{apiKey}}

### Get TripSession by ID
# Copy tripSessionId from the create/active response into tukiTripSessionId.
GET {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}
Accept: application/json
X-API-Key: {{apiKey}}

### Start navigation
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/start
Accept: application/json
X-API-Key: {{apiKey}}

### Get generated navigation instructions
GET {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/instructions
Accept: application/json
X-API-Key: {{apiKey}}

### Submit a good GPS update for map matching and progress
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/location
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "latitude": {{tukiOriginLat}},
  "longitude": {{tukiOriginLon}},
  "accuracyMeters": 8,
  "timestamp": "{{$datetime iso8601}}",
  "speedMetersPerSecond": 1.2,
  "bearingDegrees": 45
}

### Submit an intentionally inaccurate GPS update
# Expected result: rejected/uncertain GPS without changing route progress.
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/location
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "latitude": {{tukiOriginLat}},
  "longitude": {{tukiOriginLon}},
  "accuracyMeters": 250,
  "timestamp": "{{$datetime iso8601}}"
}

### Confirm boarding after reaching the boarding state
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/boarding-confirmed
Accept: application/json
X-API-Key: {{apiKey}}

### SIMULATION: first GPS sample near the planned alighting point
# Before running this, copy the PrepareToAlight instruction coordinates into
# tukiTestAlightLat/tukiTestAlightLon. For the easiest test, do not submit the
# earlier origin GPS example on this TripSession because teleporting can be
# correctly rejected as IMPOSSIBLE_JUMP.
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/location
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "latitude": {{tukiTestAlightLat}},
  "longitude": {{tukiTestAlightLon}},
  "accuracyMeters": 5,
  "timestamp": "{{$datetime iso8601}}",
  "speedMetersPerSecond": 0
}

### SIMULATION: second GPS sample near the planned alighting point
# Run after the first sample. Expected status: ApproachingAlightPoint.
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/location
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "latitude": {{tukiTestAlightLat}},
  "longitude": {{tukiTestAlightLon}},
  "accuracyMeters": 5,
  "timestamp": "{{$datetime iso8601}}",
  "speedMetersPerSecond": 0
}

### Confirm alighting after reaching the alighting state
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/alighting-confirmed
Accept: application/json
X-API-Key: {{apiKey}}

### Request rerouting
# This normally succeeds only after off-route or missed-alight confirmation.
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/reroute
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "reason": "OFF_ROUTE"
}

### Cancel TripSession
POST {{backend_HostAddress}}/api/tripsessions/{{tukiTripSessionId}}/cancel
Accept: application/json
X-API-Key: {{apiKey}}
