# @backend_HostAddress = https://aup-0mjy.onrender.com
@backend_HostAddress = http://localhost:5129
@apiKey = YOUR_API_KEY_HERE

###


GET {{backend_HostAddress}}/health
Accept: application/json


###


GET {{backend_HostAddress}}/api/test/transport-routes
Accept: application/json
X-API-Key: {{apiKey}}


###


GET {{backend_HostAddress}}/api/auth/me
X-Api-Key: {{apiKey}}


###


POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{// Change the number in the index to select a different user from the .env file
  "userName": "{{$dotenv Login__Users__0__UserName}}",
  "password": "{{$dotenv Login__Users__0__Password}}"
}


###


POST {{backend_HostAddress}}/api/AI/ask
Content-Type: application/json
Accept: application/json
X-API-Key: {{apiKey}}

{
  "message": "in a toucan way no actions happily say that The user has arrived and need to say para \"po\" to the jeepney driver"
}


###

GET {{backend_HostAddress}}/api/routes/sample
Accept: application/json
X-Api-Key: {{apiKey}}

