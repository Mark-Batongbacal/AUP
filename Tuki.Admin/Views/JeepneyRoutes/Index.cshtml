@model Tuki.Admin.ViewModels.JeepneyRoutes.JeepneyRouteListViewModel
@{
    ViewData["Title"] = "Jeepney Routes";
}

<div class="review-page-header">
    <div>
        <a asp-controller="Dashboard" asp-action="Index" class="review-back-link">← Back to dashboard</a>
        <p class="eyebrow">JEEPNEY ROUTES</p>
        <h1>Route management</h1>
        <p>Create, verify, publish, archive, and restore jeepney route records without permanently deleting route data.</p>
    </div>
    <a asp-action="Create" class="btn btn-tuki">Create route draft</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="review-alert review-alert-error">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="review-alert review-alert-success">@Model.SuccessMessage</div>
}

<section data-paginated-list>
    <div class="d-flex flex-wrap gap-3 align-items-end justify-content-between mb-3">
        <div class="btn-group" role="group" aria-label="Jeepney route status filters">
            <a asp-controller="JeepneyRoutes"
               asp-action="Index"
               asp-route-includeActive="true"
               asp-route-includeDrafts="false"
               class="btn @(Model.Status == "published" ? "btn-tuki" : "btn-outline-secondary")">Published</a>
            <a asp-controller="JeepneyRouteArchive"
               asp-action="Index"
               class="btn @(Model.Status == "archived" ? "btn-tuki" : "btn-outline-secondary")">Archived</a>
            <a asp-controller="JeepneyRoutes"
               asp-action="Index"
               asp-route-includeActive="false"
               asp-route-includeDrafts="true"
               class="btn @(Model.Status == "draft" ? "btn-tuki" : "btn-outline-secondary")">Draft</a>
        </div>

        <div style="min-width: min(100%, 320px);">
            <label for="jeepneyRouteSearch" class="form-label small text-muted mb-1">Search routes</label>
            <input id="jeepneyRouteSearch"
                   type="search"
                   class="form-control"
                   placeholder="Name, code, origin, destination, operator"
                   data-list-search />
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
        <span class="text-muted small" data-list-summary></span>
        <span class="text-muted small">10 routes per page</span>
    </div>

    <div class="table-responsive admin-table-card">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Route</th>
                    <th>Origin → Destination</th>
                    <th>Status</th>
                    <th>Geometry</th>
                    <th>Fare</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var route in Model.Routes)
            {
                var searchText = $"{route.RouteName} {route.RouteCode} {route.OriginName} {route.DestinationName} {route.DirectionName} {route.OperatorName}";
                <tr data-search-text="@searchText">
                    <td>
                        <strong>@route.RouteName</strong><br />
                        <span class="text-muted small">@route.RouteCode</span>
                    </td>
                    <td>@route.OriginName → @route.DestinationName</td>
                    <td>
                        <span class="status-pill @(route.IsActive ? "status-active" : "status-archived")">
                            @(route.IsActive ? "Published" : "Draft")
                        </span>
                    </td>
                    <td>
                        @route.PointCount points
                        @if (route.HasPolyline)
                        {
                            <span class="d-block text-muted small">Polyline ready</span>
                        }
                        else
                        {
                            <span class="d-block text-muted small">No plotted geometry</span>
                        }
                    </td>
                    <td>@(route.BaseFare is null ? "Not set" : $"₱{route.BaseFare:0.00}")</td>
                    <td class="text-end">
                        <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                            <a asp-action="Edit" asp-route-id="@route.RouteId" class="btn btn-outline-tuki btn-sm">
                                @(route.IsActive ? "View" : "Edit draft")
                            </a>
                            <form asp-controller="JeepneyRouteArchive"
                                  asp-action="Archive"
                                  asp-route-id="@route.RouteId"
                                  method="post"
                                  onsubmit="return confirm('Archive this jeepney route? It can be restored later.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Archive</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
                <tr data-list-empty hidden>
                    <td colspan="6" class="text-center py-5 text-muted">No jeepney routes match the current search and filter.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3" data-list-pagination aria-label="Jeepney route pages"></div>
</section>

@section Scripts {
    <script src="~/js/admin-list-pagination.js" asp-append-version="true"></script>
}
