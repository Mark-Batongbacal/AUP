@backend_HostAddress = https://aup-0mjy.onrender.com
@apiKey = 

YOUR_API_KEY
Accept: application/json

###

GET {{backend_HostAddress}}/openapi/v1.json
Accept: application/json

###

POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  // Enter a user configured in the backend's Login__Users__<index> settings.
  // The HTTP client cannot read the backend's .env file automatically.
  "userName": "",
  "password": ""
}

###

# Set apiKey to the value returned by /api/auth/login before sending this request.
GET {{backend_HostAddress}}/api/auth/me
X-Api-Key: {{apiKey}}

###

# NVIDIA NIM Nemotron test. Set NVIDIA_API_KEY in your terminal/IDE environment.
POST https://integrate.api.nvidia.com/v1/chat/completions
Authorization: Bearer YOUR_TOKEN NVIDIA_API_KEY}}
Content-Type: application/json
Accept: application/json

{
  "model": "nvidia/nemotron-3-ultra-550b-a55b",
  "messages": [
    {
      "role": "user",
      "content": "Give a short greeting for the AUP mobile app."
    }
  ],
  "temperature": 2,
  "top_p": 0.95,
  "max_tokens": 512,
  "reasoning_budget": 512
}

###

# Temporary map route endpoint for frontend HTTP integration testing.
# Method: GET
# URL: /api/routes/sample
# Parameters: none
# Response fields:
# - routeName: label for the sample route
# - points: ordered latitude/longitude coordinates for Kotlin to convert to LatLng
# The returned coordinates are mock/test data only. Real route data will later
# come from Supabase through the backend database/repository layer.
GET {{backend_HostAddress}}/api/routes/sample
Accept: application/json

###
