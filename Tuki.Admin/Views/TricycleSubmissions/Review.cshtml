@model Tuki.Admin.ViewModels.TricycleSubmissions.TricycleSubmissionReviewViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Review Submission #{Model.Submission.TricyclePointSubmissionId}";
    var canReview = Model.Submission.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)
                    || Model.Submission.Status.Equals("NeedsChanges", StringComparison.OrdinalIgnoreCase);
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        (() => {
            const latInput = document.getElementById('Latitude');
            const lngInput = document.getElementById('Longitude');
            const mapNode = document.getElementById('review-map');
            if (!latInput || !lngInput || !mapNode || typeof L === 'undefined') return;

            // Server-rendered invariant numeric literals are the source for map initialization.
            // Do not parse editable HTML input text to decide where the submitted GPS belongs.
            const originalLat = @Html.Raw(Model.OriginalLatitudeInvariant);
            const originalLng = @Html.Raw(Model.OriginalLongitudeInvariant);
            const reviewedLat = @Html.Raw(Model.ReviewedLatitudeInvariant);
            const reviewedLng = @Html.Raw(Model.ReviewedLongitudeInvariant);

            if (![originalLat, originalLng, reviewedLat, reviewedLng].every(Number.isFinite)) return;

            const map = L.map('review-map').setView([reviewedLat, reviewedLng], 18);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.circleMarker([originalLat, originalLng], {
                radius: 8,
                weight: 3,
                color: '#0d8b97',
                fillColor: '#ffffff',
                fillOpacity: 0.95
            }).addTo(map).bindTooltip('Original passenger GPS');

            const marker = L.marker(
                [reviewedLat, reviewedLng],
                { draggable: @canReview.ToString().ToLowerInvariant() }
            ).addTo(map).bindTooltip('Admin reviewed location');

            const updateReviewedFields = (latlng) => {
                latInput.value = latlng.lat.toFixed(6);
                lngInput.value = latlng.lng.toFixed(6);
                const reviewedMapsLink = document.getElementById('reviewed-google-maps-link');
                if (reviewedMapsLink) {
                    reviewedMapsLink.href = `https://www.google.com/maps/search/?api=1&query=${latlng.lat},${latlng.lng}`;
                }
            };

            marker.on('dragend', event => updateReviewedFields(event.target.getLatLng()));
            if (@canReview.ToString().ToLowerInvariant()) {
                map.on('click', event => {
                    marker.setLatLng(event.latlng);
                    updateReviewedFields(event.latlng);
                });

                const resetButton = document.getElementById('reset-reviewed-location');
                if (resetButton) {
                    resetButton.addEventListener('click', () => {
                        const original = L.latLng(originalLat, originalLng);
                        marker.setLatLng(original);
                        updateReviewedFields(original);
                        map.setView(original, 18, { animate: false });
                    });
                }
            }

            const refreshMapLayout = () => {
                map.invalidateSize(false);
                map.setView(marker.getLatLng(), map.getZoom(), { animate: false });
            };

            window.requestAnimationFrame(refreshMapLayout);
            window.setTimeout(refreshMapLayout, 150);
            if (typeof ResizeObserver !== 'undefined') {
                const resizeObserver = new ResizeObserver(refreshMapLayout);
                resizeObserver.observe(mapNode);
            }
        })();
    </script>
}

<div class="review-detail-header">
    <div>
        <a asp-action="Index" asp-route-status="@Model.Submission.Status" class="review-back-link">← Back to submissions</a>
        <p class="eyebrow">SUBMISSION #@Model.Submission.TricyclePointSubmissionId</p>
        <h1>Verify tricycle point</h1>
        <p>Preserve the passenger GPS as evidence, verify it externally, and only save a separate Admin correction when needed.</p>
    </div>
    <span class="status-pill status-@Model.Submission.Status.ToLowerInvariant()">@Model.Submission.Status</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="review-alert review-alert-error">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="review-alert review-alert-success">@Model.SuccessMessage</div>
}
<div asp-validation-summary="ModelOnly" class="review-alert review-alert-error"></div>

@if (Model.Submission.PublishedTricyclePointId is long publishedPointId)
{
    <div class="review-alert review-alert-success">
        This submission is published as official tricycle point <strong>#@publishedPointId</strong>.
    </div>
}

<div class="review-detail-grid">
    <section class="review-panel">
        <div class="panel-heading">
            <div>
                <span class="card-kicker">PASSENGER PROOF</span>
                <h2>Submitted photo</h2>
            </div>
        </div>
        <img class="proof-image" src="@Url.Action("Proof", "TricycleSubmissions", new { id = Model.Submission.TricyclePointSubmissionId })" alt="Passenger proof for submission @Model.Submission.TricyclePointSubmissionId" />
        <dl class="review-meta-grid">
            <div><dt>Suggested TODA</dt><dd>@(Model.Submission.SuggestedTodaName ?? "Not provided")</dd></div>
            <div><dt>Suggested landmark</dt><dd>@(Model.Submission.SuggestedLandmark ?? "Not provided")</dd></div>
            <div><dt>GPS accuracy</dt><dd>@(Model.Submission.AccuracyMeters is null ? "Unknown" : $"±{Model.Submission.AccuracyMeters:0.#} m")</dd></div>
            <div><dt>Captured</dt><dd>@Model.Submission.LocationCapturedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div>
        </dl>

        <div class="submitted-location-evidence">
            <span class="card-kicker">ORIGINAL PASSENGER GPS</span>
            <div class="coordinate-evidence-grid">
                <div><span>Latitude</span><strong>@Model.OriginalLatitudeInvariant</strong></div>
                <div><span>Longitude</span><strong>@Model.OriginalLongitudeInvariant</strong></div>
            </div>
            <p>These submitted coordinates are preserved and cannot be changed by Admin review.</p>
            <a id="original-google-maps-link"
               href="@Model.OriginalGoogleMapsUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-tuki w-100">
                Verify original GPS in Google Maps
            </a>
        </div>
    </section>

    <section class="review-panel">
        <div class="panel-heading map-heading">
            <div>
                <span class="card-kicker">SECONDARY MAP REFERENCE</span>
                <h2>OpenStreetMap preview</h2>
                <p>Use this map as a visual aid only. If its streets or landmarks disagree with Google Maps, trust the submitted coordinates and verify them in Google Maps before correcting anything.</p>
            </div>
        </div>
        <div class="review-map-legend">
            <span><i class="legend-dot legend-original"></i> Original passenger GPS</span>
            <span><i class="legend-pin">●</i> Admin reviewed location</span>
        </div>
        <div id="review-map" class="review-map" aria-label="Submission location reference map"></div>
        <div class="map-verification-note">
            OpenStreetMap and Google Maps can display different road/place data. Coordinate values are the source of truth.
        </div>
    </section>
</div>

<section class="review-panel review-form-panel">
    <div class="panel-heading">
        <div>
            <span class="card-kicker">ADMIN REVIEWED LOCATION</span>
            <h2>Official point information</h2>
            <p>These coordinates start from the passenger GPS. Move the marker only after external verification shows that a correction is necessary.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a id="reviewed-google-maps-link"
               href="@Model.ReviewedGoogleMapsUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-outline-tuki">
                Open reviewed location in Google Maps
            </a>
            @if (canReview)
            {
                <button id="reset-reviewed-location" type="button" class="btn btn-outline-secondary">
                    Reset to original GPS
                </button>
            }
        </div>
    </div>

    @if (Model.HasAdminCoordinateCorrection)
    {
        <div class="review-alert review-alert-warning">
            This submission currently has an Admin coordinate correction. The original passenger GPS remains preserved above.
        </div>
    }

    <form asp-action="SaveReview" asp-route-id="@Model.Submission.TricyclePointSubmissionId" method="post" class="review-form">
        <div class="review-form-grid">
            <div class="field-group">
                <label asp-for="PointName">Point name</label>
                <input asp-for="PointName" class="form-control" disabled="@(!canReview)" />
                <span asp-validation-for="PointName" class="field-error"></span>
            </div>
            <div class="field-group">
                <label asp-for="OperatorName">Operator name</label>
                <input asp-for="OperatorName" class="form-control" disabled="@(!canReview)" />
            </div>
            <div class="field-group review-form-wide">
                <label asp-for="Address">Address</label>
                <input asp-for="Address" class="form-control" disabled="@(!canReview)" />
            </div>
            <div class="field-group review-form-wide">
                <label asp-for="Landmark">Landmark</label>
                <input asp-for="Landmark" class="form-control" disabled="@(!canReview)" />
            </div>
            <div class="field-group">
                <label for="Latitude">Reviewed latitude</label>
                <input id="Latitude" name="Latitude" value="@Model.ReviewedLatitudeInvariant" class="form-control" inputmode="decimal" readonly="@(!canReview)" />
                <span asp-validation-for="Latitude" class="field-error"></span>
            </div>
            <div class="field-group">
                <label for="Longitude">Reviewed longitude</label>
                <input id="Longitude" name="Longitude" value="@Model.ReviewedLongitudeInvariant" class="form-control" inputmode="decimal" readonly="@(!canReview)" />
                <span asp-validation-for="Longitude" class="field-error"></span>
            </div>
            <div class="field-group review-form-wide">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" disabled="@(!canReview)"></textarea>
            </div>
            <div class="field-group review-form-wide">
                <label asp-for="AdminNotes">Admin notes</label>
                <textarea asp-for="AdminNotes" class="form-control" rows="3" disabled="@(!canReview)"></textarea>
            </div>
        </div>
        @if (canReview)
        {
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-outline-tuki">Save review changes</button>
                <button type="submit"
                        formaction="@Url.Action("Approve", "TricycleSubmissions", new { id = Model.Submission.TricyclePointSubmissionId })"
                        class="btn btn-tuki"
                        onclick="return confirm('Approve this submission and publish the reviewed location as an official active tricycle point?');">
                    Approve &amp; Publish
                </button>
            </div>
        }
    </form>
</section>

@if (canReview)
{
    <section class="review-actions-grid">
        <form asp-action="NeedsChanges" asp-route-id="@Model.Submission.TricyclePointSubmissionId" method="post" class="review-action-card">
            <h3>Needs changes</h3>
            <p>Return the contribution for correction while preserving the submission.</p>
            <textarea name="Reason" class="form-control" rows="3" required minlength="3" maxlength="1000" placeholder="Explain what needs to be corrected"></textarea>
            <button type="submit" class="btn btn-outline-tuki">Mark needs changes</button>
        </form>
        <form asp-action="Reject" asp-route-id="@Model.Submission.TricyclePointSubmissionId" method="post" class="review-action-card review-action-danger">
            <h3>Reject submission</h3>
            <p>Reject duplicates, invalid locations, insufficient proof, or unrecognized points.</p>
            <textarea name="Reason" class="form-control" rows="3" required minlength="3" maxlength="1000" placeholder="Enter rejection reason"></textarea>
            <button type="submit" class="btn btn-danger">Reject submission</button>
        </form>
    </section>
}
