GET {{host}}/api/trips/{{tripId}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Get PassengerTrip alerts
GET {{host}}/api/trips/{{tripId}}/alerts
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 12 — LEGACY / LOW-LEVEL TRIP SESSION API
# ==============================================================================
#
# Prefer /api/navigation/* for the mobile navigation flow.
# Keep these for debugging the underlying state machine directly.
# ==============================================================================

### Create raw TripSession
POST {{host}}/api/tripsessions
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "recommendationId": "{{recommendationId}}"
}


### Get raw active TripSession
GET {{host}}/api/tripsessions/active
Accept: application/json
X-Api-Key: {{apiKey}}


### Get raw TripSession
GET {{host}}/api/tripsessions/{{sessionId}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Start raw TripSession
POST {{host}}/api/tripsessions/{{sessionId}}/start
Accept: application/json
X-Api-Key: {{apiKey}}


### Get generated raw instructions
GET {{host}}/api/tripsessions/{{sessionId}}/instructions
Accept: application/json
X-Api-Key: {{apiKey}}


### Raw location update
POST {{host}}/api/tripsessions/{{sessionId}}/location
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "latitude": {{originLat}},
  "longitude": {{originLon}},
  "accuracyMeters": 8,
  "timestamp": "{{$datetime iso8601}}",
  "speedMetersPerSecond": 1.2,
  "bearingDegrees": 45
}


### Raw boarding confirmation
POST {{host}}/api/tripsessions/{{sessionId}}/boarding-confirmed
Accept: application/json
X-Api-Key: {{apiKey}}


### Raw alighting confirmation
POST {{host}}/api/tripsessions/{{sessionId}}/alighting-confirmed
Accept: application/json
X-Api-Key: {{apiKey}}


### Raw reroute
POST {{host}}/api/tripsessions/{{sessionId}}/reroute
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "reason": "OFF_ROUTE"
}


### Raw cancel
POST {{host}}/api/tripsessions/{{sessionId}}/cancel
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 13 — DRIVER API
# ==============================================================================

### Driver details
GET {{host}}/api/drivers/{{driverId}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Driver current vehicle
GET {{host}}/api/drivers/{{driverId}}/vehicle
Accept: application/json
X-Api-Key: {{apiKey}}


### Driver availability
GET {{host}}/api/drivers/{{driverId}}/availability
Accept: application/json
X-Api-Key: {{apiKey}}


### Start driver availability
POST {{host}}/api/drivers/{{driverId}}/availability/start
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "vehicleId": "{{vehicleId}}",
  "destinationStopId": null,
  "destinationName": "SM City Clark",
  "destinationLatitude": 15.1683,
  "destinationLongitude": 120.5805,
  "availableSeats": 3,
  "maximumDetourMeters": 1000,
  "startedAt": null
}


### Update driver location
PUT {{host}}/api/drivers/{{driverId}}/location
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "latitude": {{originLat}},
  "longitude": {{originLon}},
  "headingDegrees": 90,
  "speedKph": 25,
  "accuracyMeters": 8,
  "updatedAt": null
}


### Stop driver availability
POST {{host}}/api/drivers/{{driverId}}/availability/stop
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "endedAt": null
}


# ==============================================================================
# 14 — RIDE MATCHING
# ==============================================================================

### Create passenger ride request
POST {{host}}/api/ride-matching/requests
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "pickupName": "Current location",
  "pickupLatitude": {{originLat}},
  "pickupLongitude": {{originLon}},
  "dropoffName": "{{destinationName}}",
  "dropoffLatitude": {{destinationLat}},
  "dropoffLongitude": {{destinationLon}},
  "passengerCount": 1,
  "transportModeId": null,
  "maxBudget": 100,
  "requestedAt": null,
  "expiresAt": null
}


### Get ride request
GET {{host}}/api/ride-matching/requests/{{rideRequestId}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Create ride match — normally backend/driver-side workflow
POST {{host}}/api/ride-matching/requests/{{rideRequestId}}/match
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "driverId": "{{driverId}}",
  "vehicleId": "{{vehicleId}}",
  "pickupDistanceMeters": 450,
  "detourDistanceMeters": 100,
  "estimatedPickupMinutes": 5,
  "estimatedTripMinutes": 15,
  "estimatedFare": 50,
  "matchScore": 0.9,
  "offeredAt": null
}


### Get ride match
GET {{host}}/api/ride-matching/matches/{{rideMatchId}}
Accept: application/json
X-Api-Key: {{apiKey}}


### Accept ride match
POST {{host}}/api/ride-matching/matches/{{rideMatchId}}/accept
Content-Type: application/json
Accept: application/json
X-Api-Key: {{apiKey}}

{
  "acceptedAt": null
}


### Reject ride match
POST {{host}}/api/ride-matching/matches/{{rideMatchId}}/reject
Accept: application/json
X-Api-Key: {{apiKey}}


### Cancel ride match
POST {{host}}/api/ride-matching/matches/{{rideMatchId}}/cancel
Accept: application/json
X-Api-Key: {{apiKey}}


# ==============================================================================
# 15 — QUICK END-TO-END CHECKLIST
# ==============================================================================
#
# Run in this order:
#
#   [ ] GET  /health
#   [ ] POST /api/auth/login                 -> copy apiKey
#   [ ] GET  /api/users/me
#   [ ] GET  /api/places/search
#   [ ] POST /api/journeys/plan             -> copy recommendationId
#   [ ] POST /api/navigation/start           -> copy sessionId
#   [ ] GET  /api/navigation/active
#   [ ] POST /api/navigation/{id}/location
#   [ ] POST boarding/alighting when snapshot asks for confirmation
#
# Things worth inspecting in NavigationSnapshot:
#
#   state
#   currentLeg
#   nextInstruction
#   spokenInstruction
#   boardInfo.landmark
#   alightInfo.landmark
#   landmark
#   requiresBoardingConfirmation
#   requiresAlightingConfirmation
#   rerouteRequired
#   status
#   triggeredEvents
#
# ==============================================================================
