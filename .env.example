# Documentation only: production deployment does not copy this file to .env.
# Ansible reads non-secret values from infra/ansible/group_vars/all.yml and
# secrets from encrypted group_vars/vault.yml, then renders runtime/*.env.

# Public DNS names. Point both A/AAAA records at the GCP VM before deployment.
API_HOSTNAME=api.example.com
ADMIN_HOSTNAME=admin.example.com
ACME_EMAIL=ops@example.com

# Host directory containing persistent service data.
TUKI_DATA_ROOT=/opt/tuki/data
TUKI_IMAGE_TAG=dev

# SQL Server values rendered into runtime/sqlserver.env. Compose never creates,
# restores, or replaces the Tuki database.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=replace-with-a-long-random-password
TUKI_DATABASE=Tuki

# Backend-only values rendered into runtime/backend.env.
AdminLogin__UserName=replace-with-admin-username
AdminLogin__Password=replace-with-a-long-random-password

# Application login accounts. Add more numbered entries when required.
Login__Users__0__UserName=replace-with-user-email
Login__Users__0__Password=replace-with-a-long-random-password

# External providers and application secrets (backend only).
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
Google__ClientId=replace-with-google-client-id
Facebook__AppId=replace-with-facebook-app-id
Facebook__AppSecret=replace-with-facebook-app-secret
Email__ConnectionString=replace-with-azure-communication-services-connection-string
Email__SenderAddress=replace-with-verified-sender-address

# Non-secret runtime image/data tuning. Pin immutable image tags before rollout.
VALHALLA_IMAGE=ghcr.io/nilsnolde/docker-valhalla/valhalla:latest
VALHALLA_TILE_URLS=https://download.geofabrik.de/asia/philippines-latest.osm.pbf
PELIAS_API_IMAGE=pelias/api:master
PELIAS_ELASTICSEARCH_IMAGE=pelias/elasticsearch:7.17.27
PELIAS_ES_JAVA_OPTS=-Xms1g -Xmx1g
